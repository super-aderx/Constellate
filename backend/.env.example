# The warehouse (constella-data-platform's docker-compose), as the read-only api_reader role.
DATABASE_URL=postgresql://api_reader:api_reader_dev@localhost:5433/warehouse
# The store used when a request has no X-Tenant-Key header, until sign-in exists.
CONSTELLA_DEFAULT_TENANT=harbor-street

# The app database (read/write): what Constellate owns itself, such as campaigns. Any Postgres 17
# database whose role can create a schema, e.g. a `constellate` database in the test container:
#   docker exec constella-test-pg createdb -U postgres constellate
# Then create its schema and mock data (safe to re-run): uv run --env-file .env python -m app.app_db init
# Without it the API still runs; the campaign endpoints answer 503.
APP_DATABASE_URL=postgresql://postgres:postgres@localhost:5434/constellate

# Tests: an admin connection to any Postgres 17 server. They create their own database
# (constella_api_test) and read-only role there, and never touch any other database. For example:
#   docker run -d --name constella-test-pg -p 5434:5432 -e POSTGRES_PASSWORD=postgres postgres:17
TEST_POSTGRES_URL=postgresql://postgres:postgres@localhost:5434/postgres

# Constella AI (OpenAI). Yours to fill in: AI stays off, and the app shows its scripted answers,
# until both the key and the model are set.
OPENAI_API_KEY=
CONSTELLA_AI_MODEL=
# AI requests per store per day.
CONSTELLA_AI_DAILY_LIMIT=50
