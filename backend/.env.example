# The warehouse (constella-data-platform's docker-compose), as the read-only api_reader role.
DATABASE_URL=postgresql://api_reader:api_reader_dev@localhost:5433/warehouse
# The store used when a request has no X-Tenant-Key header, until sign-in exists.
CONSTELLA_DEFAULT_TENANT=harbor-street

# Tests: an admin connection to any Postgres 17 server. They create their own database
# (constella_api_test) and read-only role there, and never touch any other database. For example:
#   docker run -d --name constella-test-pg -p 5434:5432 -e POSTGRES_PASSWORD=postgres postgres:17
TEST_POSTGRES_URL=postgresql://postgres:postgres@localhost:5434/postgres
